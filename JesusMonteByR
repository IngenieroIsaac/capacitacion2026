    <header class="gradient-header text-white py-6 shadow-xl">
        <div class="container mx-auto px-4 text-center">
            <h1 class="text-2xl font-bold tracking-widest uppercase">PC Consultoría e Ingeniería</h1>
            <p class="text-blue-200 text-xs mt-1 font-medium tracking-wider">SISTEMA OFICIAL DE VERIFICACIÓN DE CAPACITACIÓN</p>
        </div>
    </header>

    <main class="flex-grow container mx-auto px-4 py-10 max-w-lg">
        <!-- Pantalla de Carga -->
        <div id="loading" class="text-center py-20">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-blue-900 border-t-transparent"></div>
            <p class="mt-4 text-gray-500 font-semibold italic">Verificando en base de datos...</p>
        </div>

        <!-- Resultado Éxito -->
        <div id="result-card" class="hidden bg-white rounded-2xl shadow-2xl overflow-hidden animate-in border border-gray-100">
            <div class="bg-emerald-600 p-6 text-center text-white">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-white/20 rounded-full mb-3">
                    <i class="fas fa-check text-3xl"></i>
                </div>
                <h2 class="text-xl font-bold uppercase">Documento Auténtico</h2>
                <p class="text-xs text-emerald-100">Validado exitosamente para el ciclo 2026</p>
            </div>

            <div class="p-8 space-y-6">
                <div>
                    <label class="text-[10px] text-gray-400 font-black uppercase tracking-tighter">Participante</label>
                    <p id="res-nombre" class="text-xl font-bold text-slate-800 leading-tight uppercase"></p>
                </div>

                <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-50">
                    <div>
                        <label class="text-[10px] text-gray-400 font-black uppercase">No. de Folio</label>
                        <p id="res-folio" class="text-sm font-mono font-bold text-blue-700"></p>
                    </div>
                    <div>
                        <label class="text-[10px] text-gray-400 font-black uppercase">Resultado</label>
                        <p class="text-sm font-bold text-slate-700">Aprobado (<span id="res-calif"></span>/10)</p>
                    </div>
                </div>

                <div class="bg-slate-50 p-5 rounded-xl border border-slate-100">
                    <label class="text-[10px] text-gray-400 font-black uppercase">Capacitación Impartida</label>
                    <p id="res-tema" class="text-sm font-bold text-slate-800 mb-2"></p>
                    <div class="flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-slate-500 font-bold italic">
                        <span><i class="far fa-calendar-alt mr-1"></i> <span id="res-fecha"></span></span>
                        <span><i class="far fa-clock mr-1"></i> <span id="res-duracion"></span></span>
                    </div>
                </div>

